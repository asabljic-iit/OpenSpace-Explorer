local ClearSatellites = {
    Identifier = "ClearSatellites",
    Name = "Turn off all satellites",
    Command = [[
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Motion", 0.000000)

        openspace.fadeOut("Scene.BrightestSatellites.Renderable")
        openspace.fadeOut("Scene.GeoStationarySatellites.Renderable")
        openspace.fadeOut("Scene.GpsSatellites.Renderable")
        openspace.fadeOut("Scene.Last30DaysSatellites.Renderable")
        openspace.fadeOut("Scene.SpaceStations.Renderable")
        openspace.fadeOut("Scene.StarlinkSatellites.Renderable")

        openspace.isStarlinkOn = false
        openspace.is100BrightestOn = false
        openspace.isGeostationaryOn = false
        openspace.isGPSOn = false
        openspace.isLast30DaysOn = false
        openspace.isSpaceStationsOn = false
    ]],
    GuiPath = "/Satellites",
    IsLocal = false
}

local ToggleAllSatellites = {
    Identifier = "ToggleAllSatellites",
    Name = "Toggle All Satellites",
    Command = [[
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Motion", 0.000000)

        openspace.isAllSatellitesOn = not openspace.isAllSatellitesOn
        
        local state = openspace.isAllSatellitesOn
        openspace.is100BrightestOn = state
        openspace.isGeostationaryOn = state
        openspace.isGPSOn = state
        openspace.isLast30DaysOn = state
        openspace.isSpaceStationsOn = state
        openspace.isStarlinkOn = state
        
        if not openspace.isAllSatellitesOn then
            openspace.fadeOut("Scene.SpaceStations.Renderable")
            openspace.fadeOut("Scene.BrightestSatellites.Renderable")
            openspace.fadeOut("Scene.GeoStationarySatellites.Renderable")
            openspace.fadeOut("Scene.GpsSatellites.Renderable")
            openspace.fadeOut("Scene.Last30DaysSatellites.Renderable")
            openspace.fadeOut("Scene.StarlinkSatellites.Renderable")
        else
            local navState = openspace.navigation.getNavigationState()
            if navState.Anchor ~= "Earth" then
                openspace.navigation.setFocus("Earth", true, true)
                openspace.navigation.flyTo("Earth", 10)
            end

            openspace.navigation.zoomToDistance(116378137, 1.5)   

            openspace.fadeIn("Scene.SpaceStations.Renderable")
            openspace.fadeIn("Scene.BrightestSatellites.Renderable")
            openspace.fadeIn("Scene.GeoStationarySatellites.Renderable")
            openspace.fadeIn("Scene.GpsSatellites.Renderable")
            openspace.fadeIn("Scene.Last30DaysSatellites.Renderable")
            openspace.fadeIn("Scene.StarlinkSatellites.Renderable")

            openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Apply", true)

            openspace.satelliteCounter = (openspace.satelliteCounter or 0) + 1
            local clearLogic = "if openspace.satelliteCounter == " .. openspace.satelliteCounter .. " then openspace.action.triggerAction('ClearSatellites') end"
            openspace.scheduleScript(clearLogic, 15)
        end
    ]],
    GuiPath = "/Satellites",
    IsLocal = false
}

local FlyToISS = {
    Identifier = "FlyToISS",
    Name = "Fly to the International Space Station",
    Command = [[
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Motion", 0.000000)
        openspace.scheduleScript("openspace.setPropertyValueSingle('NavigationHandler.OrbitalNavigator.IdleMotion.Apply', true)", 11)
        openspace.navigation.flyTo("ISS", 10)
    ]],
    GuiPath = "/Satellites",
    IsLocal = false
}

local FlyToTiangong = {
    Identifier = "FlyToTiangong",
    Name = "Fly to Tiangong",
    Command = [[
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Motion", 0.000000)
        openspace.scheduleScript("openspace.setPropertyValueSingle('NavigationHandler.OrbitalNavigator.IdleMotion.Apply', true)", 11)
        openspace.navigation.flyTo("Tiangong", 10)
    ]],
    GuiPath = "/Satellites",
    IsLocal = false
}

asset.onInitialize(function()
    openspace.action.registerAction(ToggleStarlink)
    openspace.action.registerAction(Toggle100Brightest)
    openspace.action.registerAction(ToggleGeostationary)
    openspace.action.registerAction(ToggleGPS)
    openspace.action.registerAction(ToggleLast30Days)
    openspace.action.registerAction(ToggleSpaceStations)
    openspace.action.registerAction(ClearSatellites)
    openspace.action.registerAction(ToggleAllSatellites)
    openspace.action.registerAction(FlyToISS)
    openspace.action.registerAction(FlyToTiangong)
end)

asset.onDeinitialize(function()
    openspace.action.removeAction(FlyToTiangong)
    openspace.action.removeAction(FlyToISS)
    openspace.action.removeAction(ToggleAllSatellites)
    openspace.action.removeAction(ClearSatellites)
    openspace.action.removeAction(ToggleSpaceStations)
    openspace.action.removeAction(ToggleLast30Days)
    openspace.action.removeAction(ToggleGPS)
    openspace.action.removeAction(ToggleGeostationary)
    openspace.action.removeAction(Toggle100Brightest)
    openspace.action.removeAction(ToggleStarlink)
end)