local FocusOnMercury = {
    Identifier = "FocusOnMercury",
    Name = "Face Mercury",
    Command = [[
        openspace.navigation.setFocus("Mercury",true,true)
    ]],
    GuiPath = "/Solar System/Mercury",
    IsLocal = false
}

local FlyToMercury = {
    Identifier = "FlyToMercury",
    Name = "Fly to Mercury",
    Command = [[
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Motion", 0.000000)
        openspace.setPropertyValueSingle("NavigationHandler.OrbitalNavigator.IdleMotion.Apply", true)
        openspace.navigation.setFocus("Mercury",true,true)
        openspace.navigation.flyTo("Mercury", 10)
    ]],
    GuiPath = "/Solar System/Mercury",
    IsLocal = false
}

